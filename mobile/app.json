{
  "expo": {
    "name": "Path Clear",
    "slug": "path-clear",
    "scheme": "pathclear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Path Clear requires foreground location to detect whether you are on an active ambulance route and alert you to move aside."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Path Clear requires foreground location to detect whether you are on an active ambulance route and alert you to move aside."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
